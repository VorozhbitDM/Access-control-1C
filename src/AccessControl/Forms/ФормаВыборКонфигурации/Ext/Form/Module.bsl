
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ИмяКонфигурации", ИмяКонфигурации);
	Параметры.Свойство("ОпределеннаяКонфигурация", ОпределеннаяКонфигурация);
	Параметры.Свойство("ПервыйЗапуск", ПервыйЗапуск);
	Параметры.Свойство("СписокКонфигураций", СписокКонфигураций);
	
	ЗаполнитьСписокКонфигураций(СписокКонфигураций);
	
	Если НЕ ЗначениеЗаполнено(ИмяКонфигурации) Тогда
		ИмяКонфигурации = ИмяКонфигурацииПоУмолчанию();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОпределеннаяКонфигурация) Тогда
		Элементы.ДекорацияОпределение.Заголовок = СтрШаблон(
			"Автоматически определена конфигурация: %1. Подтвердите выбор или укажите другую.",
			ПредставлениеКонфигурации(ОпределеннаяКонфигурация));
	Иначе
		Элементы.ДекорацияОпределение.Заголовок =
			"Не удалось автоматически определить конфигурацию. В качестве выбранной предложена «Другая конфигурация».";
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Подтвердить(Команда)
	
	Если НЕ ЗначениеЗаполнено(ИмяКонфигурации) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите конфигурацию из списка.'"));
		Возврат;
	КонецЕсли;
	
	Закрыть(Новый Структура("ИмяКонфигурации", ИмяКонфигурации));
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьСписокКонфигураций(СписокКонфигурацийИзПараметра = Неопределено)
	
	Если СписокКонфигурацийИзПараметра <> Неопределено Тогда
		СписокКонфигураций = СписокКонфигурацийИзПараметра;
	КонецЕсли;
	
	Если СписокКонфигураций = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.ИмяКонфигурации.СписокВыбора.Очистить();
	
	Для Каждого ЭлементСписка Из СписокКонфигураций Цикл
		Элементы.ИмяКонфигурации.СписокВыбора.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПредставлениеКонфигурации(Имя)
	
	Если СписокКонфигураций <> Неопределено Тогда
		ЭлементСписка = СписокКонфигураций.НайтиПоЗначению(Имя);
		Если ЭлементСписка <> Неопределено Тогда
			Возврат ЭлементСписка.Представление;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Имя;
	
КонецФункции

&НаСервере
Функция ИмяКонфигурацииПоУмолчанию()
	
	Если ЗначениеЗаполнено(ОпределеннаяКонфигурация) Тогда
		Возврат ОпределеннаяКонфигурация;
	КонецЕсли;
	
	Возврат "Другая";
	
КонецФункции

#КонецОбласти
